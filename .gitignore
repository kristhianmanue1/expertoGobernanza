# Python
__pycache__/
*.py[cod]
*.egg-info/

# Entornos virtuales (este proyecto y backup del roto)
.venv/
.venv.broken-310/

# AN-KLA: memoria local, NO versionar
.an-kla/

# macOS
.DS_Store

# Archivos efímeros del ciclo de escritura AN-KLA en raíz
# (los históricos viven bajo .archive/, que SÍ se versiona)
/proposal.json
/authority.json

# Corpus: originales oficiales (PDF/binarios grandes) — NO se versionan;
# se conservan vía hash + URL en corpus/registry.yaml (componente A del dictamen)
corpus/originals/

# Texto completo extraído (working file grande) — se conservan los extractos por-artículo
# bajo docs/fuentes/ y los modelos bajo corpus/derived/
corpus/derived/*_full.txt

# Bitácora del router de revisión multi-provider (§7.4) — NO versionar (data de auditoría local)
logs/

# Spikes locales (wheels, venv, reportes full con paths)
.spikes/

# e.firma (FIEL) del SAT: la llave privada (.key) y derivados NUNCA entran al
# repo. El .cer público tampoco se versiona: el ADR-0005 registra serial + hash
# para verificación; el certificado vive fuera del repo, en control del humano.
*.key
*.cer
*.pem
*.p12
*.pfx
