{"citation_rule": "verify_page_and_fragment_visually_before_new_quote", "content_currentness": "not_established", "operation": "page", "result": {"derivation_id": "372fdaef7fb1171ec8dce708b79ef1e32b38e43dfb1b079e6b27ae070d8f7587", "lines": [{"bbox": [0.3659640522875817, 0.052290151515151595, 0.7634428758169934, 0.07205606060606062], "item_id": "3df177f4f2b3fd7fe4a997f5c2ecc5f6c5bda40bcc3828158e3830e24960dfd6", "text": "MANUAL DE ORGANIZACIÓN DE LA"}, {"bbox": [0.33223856209150326, 0.07259318181818175, 0.7972791503267976, 0.09235909090909078], "item_id": "38924a0bde80b5ca207c836bbfc791ce5a20e96ea3a1de1b60b33d54f02127a7", "text": "DIRECCIÓN DE PRESTACIONES MÉDICAS"}, {"bbox": [0.09254901960784313, 0.13797979797979798, 0.645777777777778, 0.15487373737373733], "item_id": "6a7a856c86bf4790f1ddf067c6d72bf2b79c2d435f2c2f9b1ee32c78abcaff6d", "text": "7.1.4.4.1 Coordinación Técnica de Infraestructura Médica"}, {"bbox": [0.11572549019607843, 0.17282828282828278, 0.902875816993464, 0.18972222222222224], "item_id": "02af99a2ae07ed43a6d6328993f661e79086ef8b79744acd3fad1a26569f3202", "text": "1. Coordinar de manera conjunta con las áreas normativas correspondientes, los"}, {"bbox": [0.17375816993464052, 0.19025252525252523, 0.9029346405228759, 0.20714646464646458], "item_id": "e40f610b73e3362568bb32b728195aef3988a4a6123228ed3036073181094beb", "text": "instrumentos de planeación de obra de unidades médicas, con el objetivo de que se"}, {"bbox": [0.17375816993464052, 0.20767676767676768, 0.9028366013071895, 0.22457070707070714], "item_id": "69f8e4de42624cc8d0e7263935bddbb04a3a06f3f87c0cc4c2a36e23880d0853", "text": "enmarquen en las políticas y prioridades definidas por la Dirección de Prestaciones"}, {"bbox": [0.17375816993464052, 0.22510101010101002, 0.25226797385620914, 0.24199494949494949], "item_id": "f9572740a504301964eb4475453d3f42e4593bb9af89d10108ed2bdf6e536b96", "text": "Médicas."}, {"bbox": [0.11572549019607843, 0.25994949494949493, 0.9027581699346404, 0.2768434343434343], "item_id": "a26e41d730a8b85c5654a3c8f79746fdd0041bba5ed66ad8a29611d013352721", "text": "2. Diseñar propuestas de planes de mediano y largo plazo, para fomentar la ampliación"}, {"bbox": [0.17375816993464052, 0.2773737373737373, 0.7425424836601308, 0.29426767676767673], "item_id": "ab082f580d2f1facf3f58dd9e43980259069b4ac1887329761ec616b069cb494", "text": "de oferta y capacidades de la infraestructura médica institucional."}, {"bbox": [0.11572549019607843, 0.31226010101010093, 0.9027189542483659, 0.3291540404040403], "item_id": "0a8eebbad162925765d9971bd4121d2df6cd2c0b06de91be8d18c4030c2a9aff", "text": "3. Definir los elementos técnicos en materia de infraestructura médica que deben ser"}, {"bbox": [0.17375816993464052, 0.3296843434343435, 0.9027581699346404, 0.34657828282828285], "item_id": "c231ae27f878cd297f93e34ae1eaeaff2cf5073ae0b10ddb90e554c6e446a521", "text": "considerados en la planeación, con el fin de integrar las propuestas de inclusión para"}, {"bbox": [0.17375816993464052, 0.34710858585858584, 0.9031699346405229, 0.3640025252525252], "item_id": "18cca2befd2371f52c42ba17b7e005d5ac33263fb1c13b77eb1a348c83767526", "text": "atender las necesidades y requerimientos de modernización y/o actualización en las"}, {"bbox": [0.17375816993464052, 0.3645328282828283, 0.4429542483660132, 0.38142676767676764], "item_id": "d326940859621ee9e77553a331ef0ec735e337efb6048148837bab8a442aba0f", "text": "unidades médicas del Instituto."}, {"bbox": [0.11572549019607843, 0.3993813131313131, 0.9028954248366011, 0.41627525252525255], "item_id": "af94a12ffffb5e451b8cb4d7144a147f6049d5c21cc5684f5fd9a85dbefaae55", "text": "4. Coordinar el desarrollo del diagnóstico de necesidades plasmado en mecanismo de"}, {"bbox": [0.17375816993464052, 0.41680555555555554, 0.9029150326797383, 0.4336994949494949], "item_id": "2b21831f62bddf2459331c71900fe96c6f00f59a50aa32e5c843a8d1a3df7082", "text": "planeación médica en los tres niveles de atención, así como su priorización para el"}, {"bbox": [0.17375816993464052, 0.434229797979798, 0.9028954248366013, 0.45112373737373734], "item_id": "d4dadcef62e991ab7de5d4c3c3c912004929fcacca8c9a391f40cb401dcf75fe", "text": "mantenimiento, desarrollo y modernización de las unidades y los servicios para"}, {"bbox": [0.17375816993464052, 0.45165404040404034, 0.9030718954248367, 0.4685479797979798], "item_id": "e7d0bf38e0879a994b81c606aeb98b9be1cc700e40be076e13925f29786cd6ce", "text": "responder a las necesidades de los derechohabientes, considerando los"}, {"bbox": [0.17375816993464052, 0.4690782828282828, 0.8526209150326799, 0.48597222222222225], "item_id": "b2457eced3399ac2b9185ef667b0aeeccdf0b36891e9d3dc90fdcbb17c0003eb", "text": "requerimientos de los OOAD en concordancia con las políticas institucionales."}, {"bbox": [0.11572549019607843, 0.5039267676767676, 0.9027777777777775, 0.5208207070707069], "item_id": "b1975c3f2fc0904277ea67d2d7d311bd571878ad440d182533c480ceb9f3c1d4", "text": "5. Establecer y validar los indicadores de seguimiento de programa presupuestario"}, {"bbox": [0.17375816993464052, 0.52135101010101, 0.9027777777777778, 0.5382449494949495], "item_id": "5f5949c4b4f80aac720d86addc037c2a82761e09de40e6e3ad7e55aa8bc37db4", "text": "relativos a la planeación de la Infraestructura Médica, obtenidos por los Órganos de"}, {"bbox": [0.17375816993464052, 0.5388005050505049, 0.9027777777777778, 0.5556944444444444], "item_id": "5c40d3cfe5dc58875a690ce83dd7aa508d4872ac17a1ffc98401c97bfcf3cc7a", "text": "Operación Administrativa Desconcentrada Estatales o Regionales, y Unidades"}, {"bbox": [0.17375816993464052, 0.5562247474747475, 0.4354738562091503, 0.5731186868686868], "item_id": "48293a4925bd96baf4d999285559de27e1fbdf85cd14226ed3b23eec8abb9bda", "text": "Médicas de Alta Especialidad."}, {"bbox": [0.11572549019607843, 0.5910732323232324, 0.9027973856209149, 0.6079671717171717], "item_id": "fda520b019d3b1e306a5ac932d0366e3343390cdc88f1994c369d7241fbd3cfc", "text": "6. Sancionar el listado de servicios, áreas, y/o locales que conforman los modelos de"}, {"bbox": [0.17375816993464052, 0.6084974747474747, 0.9028366013071897, 0.6253914141414141], "item_id": "5c87feade3527a8b6b7e0a1cf2ec16c27796649b54194b8d2504446117766050", "text": "unidades y servicios de Infraestructura Médica que cumplan con la normatividad"}, {"bbox": [0.17375816993464052, 0.6259217171717171, 0.9028366013071897, 0.6428156565656565], "item_id": "52ac4716f6b373ca1acc798f869ec4fb4de7d5ee9b41d41b47662a01f8224b04", "text": "vigente, los programas y modelos médicos consensuados con las áreas normativas"}, {"bbox": [0.17375816993464052, 0.6433459595959596, 0.9028562091503269, 0.660239898989899], "item_id": "cfabacbacc08451aa016dce892875ff98d20e820c051415f89f19fbddcdd0323", "text": "correspondientes con el objetivo de contar con unidades médicas funcionales que"}, {"bbox": [0.17375816993464052, 0.660770202020202, 0.902758169934641, 0.6776641414141414], "item_id": "2de9e4c68321cae0da7c99557927871171fcfa12964284b9d21453f1251a9d2c", "text": "contribuyan a satisfacer las necesidades de la derechohabiencia en materia de"}, {"bbox": [0.17375816993464052, 0.6781944444444445, 0.3339934640522876, 0.6950883838383839], "item_id": "35f6984db122adc58f297c5ec098b007b46ab83e824b44fa9907d54c40563cfa", "text": "servicios médicos."}, {"bbox": [0.11572549019607843, 0.7130429292929293, 0.9026797385620914, 0.7299368686868687], "item_id": "1cef07119849c9211c995297611a22f88e5aada7bc9a24613bfe48da7d2a3a19", "text": "7. Validar el diseño de la infraestructura médica, con el objeto de contar con unidades"}, {"bbox": [0.17375816993464052, 0.7304671717171718, 0.9028169934640521, 0.7473611111111111], "item_id": "136a8cb447b3847a674f4c097aee1afa3b62b8cff57c36f4669d24140ae50b95", "text": "médicas funcionales que contribuyan a satisfacer las necesidades de la"}, {"bbox": [0.17375816993464052, 0.7479292929292929, 0.9027777777777778, 0.7648232323232323], "item_id": "c35d3ab2577e3b563e36d14c2148747dc56525fe0afff24ba0591a1d029db8fe", "text": "derechohabiencia en materia de servicios médicos y cumplan con la normatividad"}, {"bbox": [0.17375816993464052, 0.7653535353535355, 0.2567385620915033, 0.7822474747474748], "item_id": "f976a46e6ec98f37267fd9b7509b3a7ec4204b7ab5c108cbe5622e4e9d025908", "text": "aplicable."}, {"bbox": [0.11572549019607843, 0.8002020202020202, 0.9028169934640524, 0.8170959595959596], "item_id": "539aac3b20d97c40882a8dd1de6e12caaa3129061efb452cea8dd9020b88b755", "text": "8. Acordar con las áreas normativas involucradas, el diseño de los procesos de"}, {"bbox": [0.17375816993464052, 0.8176262626262626, 0.9030326797385622, 0.834520202020202], "item_id": "76fa29a86b97ffbd1d104650b5b5e01d4bcb371c31353ce9daac1a6c77770aad", "text": "atención médica, a efecto de actualizar los criterios y lineamientos para la integración"}, {"bbox": [0.17375816993464052, 0.835050505050505, 0.9026797385620914, 0.8519444444444444], "item_id": "134ebc6667990b46f3580a8f599302543428383a1426e0d4ec499944542fc605", "text": "de las plantillas de personal de salud, en caso de obra nueva, remodelación y/o"}, {"bbox": [0.17375816993464052, 0.8524747474747475, 0.9027385620915035, 0.8693686868686868], "item_id": "a9f774c191dcea0f1b9be7927e29edead052e6a53ce828f26dc30aa73ddb7d9c", "text": "ampliación de infraestructura médica, con el propósito de asegurar la eficiencia y"}, {"bbox": [0.17375816993464052, 0.8698939393939393, 0.3688169934640523, 0.8867878787878788], "item_id": "244ed5dca57cd40adad8ce0fbe5cc92b98685d6791a0e5d53e856f5aa7ae7c22", "text": "calidad de la atención."}, {"bbox": [0.4306699346405229, 0.9299522727272728, 0.5713283006535947, 0.9439742424242424], "item_id": "7c602788d2106d6c8c1471bb91cbbbbedad1f6b5fef6083980d878c5e1368789", "text": "Página 172 de 188"}, {"bbox": [0.7601633986928105, 0.9299522727272728, 0.9152903267973856, 0.9439742424242424], "item_id": "f3118d341e560d255f9a22b0702cdb6af323733030d312e7702c597083ddf95b", "text": "Clave: 2000-002-001"}], "manifest_sha256": "7f81b1616b10549439cd536737e76663cfea7cec3bf