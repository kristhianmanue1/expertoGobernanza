{"citation_rule": "verify_page_and_fragment_visually_before_new_quote", "content_currentness": "not_established", "operation": "page", "result": {"derivation_id": "e86d5c6ab6d45d1143bc964fdcd4ecfeceda2c4a23965cc693655fd6b643eadd", "lines": [{"bbox": [0.41215774684702344, 0.0656718678988032, 0.7331536300071881, 0.0825632479927283], "item_id": "ec2ad95af025397b67fe83b8c257ef3450a2a385f80f702383c11066165438ed", "text": "MANUAL DE ORGANIZACIÓN DEL"}, {"bbox": [0.35824674900346337, 0.08309347068625961, 0.7869862118538848, 0.09998485078018471], "item_id": "3366a0f2a5613487682b67858c5afff046656832c6b3dc8bc9e2ce7e3bbfa79a", "text": "INSTITUTO MEXICANO DEL SEGURO SOCIAL"}, {"bbox": [0.09253087629876494, 0.1650759985860728, 0.4900411683983534, 0.18196737867999802], "item_id": "29e6012580daa92d2bcf9d738152c21a226fff2941a36835a49c78508ec60538", "text": "8.1.3 Dirección de Prestaciones Médicas"}, {"bbox": [0.10413644383454225, 0.19991920416098563, 0.9254851989805921, 0.21681058425491073], "item_id": "35833e3bee229880738d0013f391c120ae49a76aabbddeb48a57f4202b6b6f66", "text": "1. Aprobar las políticas para la elaboración y actualización del diagnóstico institucional de"}, {"bbox": [0.15040188198392473, 0.21734080694844216, 0.9264523296085735, 0.23423218704236726], "item_id": "84513e0137fe4aa73634ff9a745a4efd60d18110dbfe38e10a225e0f46dc7a67", "text": "servicios de salud conforme lo establecido en el Plan Nacional de Salud 2019-2024 y en"}, {"bbox": [0.15040188198392473, 0.23476240973589846, 0.4056688231065805, 0.25165378982982367], "item_id": "f2efbe5307eca1f326c7998fd5b3f8916f6aa3f2faa2a46218abc29f5219de31", "text": "el Programa IMSS-Bienestar."}, {"bbox": [0.10413644383454225, 0.2696056153108114, 0.9261092596222964, 0.2864969954047366], "item_id": "9768063345761ba917fdad07a09bebda893a30efc27d8f366a54b63353128ced", "text": "2. Aprobar la normatividad, planes, lineamientos técnico-médicos y demás regulación"}, {"bbox": [0.15040188198392473, 0.2870272180982679, 0.9257204469711818, 0.30391859819219313], "item_id": "6dc12d68389fa74135aef15d5a333a8ad65cacddd3c986dd5700e52163c0782f", "text": "referente a la prestación de servicios en los tres niveles de atención, la calidad en la"}, {"bbox": [0.15040188198392473, 0.3044866939352623, 0.9266091616023004, 0.3213780740291874], "item_id": "1028db9e7d3e45c71f1158f7a898f944b514e1db73c01c85c4ef7d5f7ff1f098", "text": "atención médica y la seguridad de los pacientes, los servicios de enfermería, la"}, {"bbox": [0.15040188198392473, 0.3219082967227188, 0.9254459909821602, 0.3387996768166439], "item_id": "955c7b739bd9c62bc5d2840ff93985f92bdd13157cc35f9ba9e6e96ec79caf37", "text": "planeación e innovación en salud, el desarrollo de la educación e investigación en salud,"}, {"bbox": [0.15040188198392473, 0.3393298995101752, 0.9254851989805921, 0.3562212796041003], "item_id": "90db06ef7a2da00eca8b7301817174b5670d746681254f951bbc3098e6822a12", "text": "la vigilancia epidemiológica, el control técnico de la calidad de insumos para la salud y"}, {"bbox": [0.15040188198392473, 0.35675150229763164, 0.9264719336077895, 0.37364288239155674], "item_id": "941d34dbc14bb39eeed549e2f024a7aa3b6e8e0ddb0273894b785eb6b4b87a4f", "text": "otros productos de uso hospitalario, los laboratorios especializados, la excelencia clínica,"}, {"bbox": [0.15040188198392473, 0.37417310508508805, 0.9257792589688294, 0.39106448517901327], "item_id": "1f34c691088742641564c57fca9722efc76e42213d58c199b9674cfef786768e", "text": "la infraestructura y equipamiento médico, así como lo referente a los trasplantes de"}, {"bbox": [0.15040188198392473, 0.3915947078725446, 0.925720446971182, 0.4084860879664697], "item_id": "e6e7a7dea3ce9ad9c501dd411aa4dfb91971e8520a33054d1658233bcb7a33ed", "text": "órganos, tejidos y células, la atención oncológica y los proyectos especiales en salud,"}, {"bbox": [0.15040188198392473, 0.409016310660001, 0.8055054564464484, 0.4259076907539262], "item_id": "a0582028967a78687d65d50e0b57ce528d8f5d77caa1f02e84f5982bddbed65f", "text": "con la finalidad de consolidar la atención integral a la salud de la población."}, {"bbox": [0.10413644383454225, 0.4438595162349138, 0.9260896556230805, 0.46075089632883903], "item_id": "bcb0543e17702ccd9dbc1a7f39edc663459ce24a0857644e29ea4db3a8def50a", "text": "3. Planear la administración del Programa IMSS-Bienestar con el propósito de que los"}, {"bbox": [0.15040188198392473, 0.46128111902237035, 0.9254655949813761, 0.47817249911629545], "item_id": "0e30968e88b0562df2a3fbd78bdc61e705188d7d904d40a3f999359750193909", "text": "recursos se ejerzan de conformidad con lo establecido en la Ley del Seguro Social, la"}, {"bbox": [0.15040188198392473, 0.47870272180982676, 0.9266091616023004, 0.49559410190375197], "item_id": "141285187808ba724381f744859c35eb6b8157f29974e095955c27b009179455", "text": "Ley Federal de Presupuesto y Responsabilidad Hacendaria y demás disposiciones"}, {"bbox": [0.15040188198392473, 0.4961243245972833, 0.31058615957655367, 0.5130157046912084], "item_id": "24994d032f69758038975e48f118029dba8677367aeed62b585a180908034daf", "text": "legales aplicables."}, {"bbox": [0.10413644383454225, 0.530992778871888, 0.9257792589688298, 0.5478841589658132], "item_id": "30963c2d076be072eabcbb4edd199fe72bdc5b1f0026adaf12b62ea877370517", "text": "4. Definir los criterios para la vigilancia epidemiológica, el análisis y los sistemas de"}, {"bbox": [0.15040188198392473, 0.5484143816593445, 0.9253675749852969, 0.5653057617532696], "item_id": "b400c639591172ed6edc44045b3522e3b223ba4a10070878503d6daba7b30aea", "text": "información en salud, con el propósito de atender oportunamente los brotes, las"}, {"bbox": [0.15040188198392473, 0.5658359844468009, 0.4971998954453375, 0.582727364540726], "item_id": "834ae5c495c40e5178d54b403034deeff237fbcda1628646eed35bcee8745b0f", "text": "epidemias y urgencias epidemiológicas."}, {"bbox": [0.10413644383454225, 0.6006791900217139, 0.9259197542965434, 0.6175705701156391], "item_id": "a115d895b753e910d7d39f7d33b97bad2dcbb7747b59cda5a8fb7d293ea099d8", "text": "5. Sancionar los programas de promoción a la salud, prevención y detección de"}, {"bbox": [0.15040188198392473, 0.6181007928091703, 0.9253479709860808, 0.6349921729030954], "item_id": "631f53a8e6bf3ce629e3ade759e4a072f1538f42f2f4d0ac2b7fce339f9c47a4", "text": "enfermedades, salud sexual y reproductiva y medicina familiar, con el propósito de"}, {"bbox": [0.15040188198392473, 0.6355223955966267, 0.6406782983728683, 0.6524137756905519], "item_id": "dcb8905021e065945f4922118305c70aa48b69f41be35a005c4c3b5c1f50bc5e", "text": "fortalecer la atención primaria a la salud de la población."}, {"bbox": [0.10413644383454225, 0.6703656011715396, 0.9259524276285697, 0.6872569812654649], "item_id": "8946e16875a2cb93dc6788124e43d9c83a64241d606138666d7ed61228dc07a4", "text": "6. Dirigir la mejora y rediseño de procesos, relacionados con la prestación de servicios"}, {"bbox": [0.15040188198392473, 0.6877872039589961, 0.9257008429719662, 0.7046785840529213], "item_id": "de026586844910404f365b81c5b6dbcebb5ca42b26bfe03ae0b94d44e0e4fd91", "text": "médicos en los hospitales de segundo nivel y las Unidades Médicas de Alta"}, {"bbox": [0.15040188198392473, 0.7052088067464526, 0.9183297392668103, 0.7221001868403778], "item_id": "9569ffdd4ba7251a78d7be55a2ae2d9bb16009638691a46074beb8075f08ae3f", "text": "Especialidad, con la finalidad de impulsar proyectos de calidad y seguridad del paciente."}, {"bbox": [0.10413644383454225, 0.7400898853709035, 0.925795595634843, 0.7569812654648286], "item_id": "8444f240495bb8d5a226acf20e550db2572f678d1d998ee15dbd4a0ef1be3065", "text": "7. Emitir los criterios de participación institucional en la atención de problemas de salud de"}, {"bbox": [0.15040188198392473, 0.7575114881583599, 0.9257008429719661, 0.774402868252285], "item_id": "48feb5dbd320673d8a98e62649ae0699cc11522880ce35b684babfbdb3615c52", "text": "la población en general, para asegurar la adecuada coordinación con las dependencias y"}, {"bbox": [0.15040188198392473, 0.7749330909458163, 0.9254655949813759, 0.7918244710397414], "item_id": "f136c2944dd6d34d5cc579ae764ccb1d7cb0036439c17e5ccf4457e4e4ec12c0", "text": "entidades de la Administración Pública Federal relacionadas con el Sistema Nacional de"}, {"bbox": [0.15040188198392473, 0.7922032015351209, 0.20617525975298961, 0.8090945816290461], "item_id": "e0811f4bfc66964fd49e39e251eeb74a7d0f3538d7a744385275f03cabe0abab", "text": "Salud."}, {"bbox": [0.10413644383454225, 0.8270464071100339, 0.9259720316277854, 0.843937787203959], "item_id": "1496987f73a1b30dbc5184cc558301a2a317bae20dfc57e96f98f1cc2c6ef943", "text": "8. Emitir los criterios para la elaboración, sanción y desarrollo de convenios con"}, {"bbox": [0.15040188198392473, 0.8444680098974903, 0.9257400509703976, 0.8613593899914154], "item_id": "26420517d7591097e3b779e6b9fad6f302fb5d1edf36baa1f9fb297c7e2f43fa", "text": "organismos nacionales e internacionales en materia de atención integral a la salud,"}, {"bbox": [0.15040188198392473, 0.8618845629450084, 0.45985100960595976, 0.8787759430389335], "item_id": "d93f14e6919026f7b2abe845833613d389905ac1af33e10d32ac15f58e3d9dac", "text": "educación e investigación en salud."}, {"bbox": [0.43627066588250674, 0.9296901984547796, 0.5586612428935503, 0.9437100439327375], "item_id": "3f0a89e23d0c38f8be6101bd1a3455659f478fe13f425e50d8aa92477e2240ba", "text": "Página 45 de 80"}, {"bbox": [0.7745213356858133, 0.9296901984547796, 0.9296179180552834, 0.9437100439327375], "item_id": "28ddf74e3542b31b7ec364e7e641c0066cf589da69222763c12d788fd1aec151", "text": "Clave: 0500-002-001"}], "manifest_sha256": "d9eeacbeab511a831999540136c72cb37c62f9aacb859fa6b75389f83e8f1ab0", "modality": "native_text", "page_number": 45, "status": "extracted"}, "runtime": "stopped", "source": {"custody_policy_sha256": "6a339819659469decb56ec610792eca85a1ec78b927bb04e66c5d090c7048f91", "custody_receipt_id": "expertogobernanza:imss-0500-002-001-2022:1:ba8eb8c2180d6cc9", "material_id": "imss-0500-002-001-2022", "sou